<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Piket Santri - Dashboard Kebersihan</title>
    
    <!-- Memuat Tailwind CSS untuk styling cepat dan responsif -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Memuat Font Inter dari Google Fonts agar tulisan rapi dan modern -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Memuat Phosphor Icons untuk ikon-ikon aplikasi yang menarik -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Konfigurasi Warna Kustom Tailwind agar sesuai dengan tema Dark Blue Dashboard -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#161822',       // Latar belakang utama gelap
                        cardBg: '#1F2232',       // Latar belakang kartu
                        cardHover: '#282C40',    // Warna kartu saat disentuh/hover
                        primaryBlue: '#4B6BFB',  // Biru utama (aksen)
                        softBlue: '#3B52C4',     // Biru lembut
                        accentGreen: '#10B981',  // Hijau untuk status selesai
                        accentOrange: '#F59E0B', // Oranye untuk status belum selesai
                        accentPink: '#EC4899'    // Pink untuk variasi grafik
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkBg text-slate-200 font-sans min-h-screen flex flex-col md:flex-row selection:bg-primaryBlue selection:text-white">

    <!-- =====================================================================
         1. SIDEBAR NAVIGASI (Kiri pada Desktop, Atas pada Mobile)
         ===================================================================== -->
    <aside class="bg-primaryBlue text-white md:w-24 lg:w-64 flex-shrink-0 flex md:flex-col justify-between items-center p-4 md:py-8 md:rounded-r-3xl shadow-xl z-10">
        <!-- Logo & Nama Aplikasi -->
        <div class="flex items-center gap-3">
            <div class="bg-white/20 p-2.5 rounded-2xl backdrop-blur-sm">
                <i class="ph-fill ph-sparkle text-2xl text-white"></i>
            </div>
            <div class="md:hidden lg:block">
                <h1 class="font-bold text-lg leading-tight tracking-wide">Smart Piket</h1>
                <p class="text-xs text-blue-200 font-medium">Santri Bersih & Rapi</p>
            </div>
        </div>

        <!-- Menu Navigasi Hari (Senin - Jumat) versi Sidebar -->
        <nav class="hidden md:flex flex-col gap-3 w-full my-auto px-2" id="sidebar-nav">
            <p class="text-xs uppercase tracking-wider text-blue-200 font-semibold px-3 mb-1 md:hidden lg:block">Pilih Hari</p>
            <!-- Tombol hari akan diisi otomatis melalui JavaScript -->
        </nav>

        <!-- Info Footer Sidebar -->
        <div class="hidden lg:block bg-softBlue/60 p-4 rounded-2xl w-full text-center border border-white/10">
            <p class="text-xs text-blue-100 mb-1">"Kebersihan sebagian dari iman"</p>
            <span class="text-[11px] bg-white/20 px-2.5 py-0.5 rounded-full font-medium">SMA IT Kelas X</span>
        </div>
    </aside>

    <!-- =====================================================================
         2. KONTEN UTAMA DASHBOARD
         ===================================================================== -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full flex flex-col gap-6">
        
        <!-- Header Atas: Judul Halaman & Tombol Reset -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl sm:text-3xl font-bold text-white">Dashboard Piket Harian</h2>
                <p class="text-slate-400 text-sm mt-1">Pantau dan tandai tugas kebersihan santri setiap hari.</p>
            </div>
            
            <!-- Fitur (5): Tombol Reset Checklist -->
            <button id="btn-reset" class="flex items-center justify-center gap-2 bg-cardBg hover:bg-rose-600/20 text-rose-400 hover:text-rose-300 border border-rose-500/30 px-4 py-2.5 rounded-2xl font-medium text-sm transition-all duration-200 cursor-pointer active:scale-95 shadow-sm">
                <i class="ph ph-arrows-counter-clockwise text-lg"></i>
                <span>Reset Checklist Hari Ini</span>
            </button>
        </header>

        <!-- Grid Layout Utama: Kolom Kiri (Utama) & Kolom Kanan (Info Kelompok & Kalendar) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- KOLOM KIRI (8 Kolom pada layar besar) -->
            <div class="lg:col-span-8 flex flex-col gap-6">
                
                <!-- Banner Sambutan (Terinspirasi dari Banner Biru pada Referensi) -->
                <div class="bg-gradient-to-r from-primaryBlue to-indigo-600 rounded-3xl p-6 sm:p-8 text-white relative overflow-hidden shadow-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="z-10">
                        <span id="badge-hari-ini" class="inline-flex items-center gap-1.5 bg-white/20 backdrop-blur-md text-xs font-semibold px-3 py-1 rounded-full mb-3">
                            <i class="ph ph-calendar-blank"></i> Jadwal Hari Senin
                        </span>
                        <h3 class="text-2xl sm:text-3xl font-bold mb-1">Assalamu'alaikum, Santri!</h3>
                        <p class="text-blue-100 text-sm sm:text-base max-w-md">
                            Mari jaga kebersihan lingkungan pondok dan sekolah agar belajar menjadi lebih nyaman dan berkah.
                        </p>
                    </div>
                    
                    <!-- Ilustrasi Ikon Besar -->
                    <div class="bg-white/15 p-4 rounded-3xl backdrop-blur-sm z-10 self-end sm:self-center">
                        <i class="ph-duotone ph-broom text-5xl sm:text-6xl text-white"></i>
                    </div>

                    <!-- Dekorasi Lingkaran Latar -->
                    <div class="w-48 h-48 bg-white/10 rounded-full absolute -right-10 -bottom-16 pointer-events-none"></div>
                    <div class="w-24 h-24 bg-white/10 rounded-full absolute right-32 -top-10 pointer-events-none"></div>
                </div>

                <!-- Fitur (4): Kartu Statistik (Jumlah Tugas Selesai, Belum Selesai, & Persentase) -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <!-- Kartu Total Tugas -->
                    <div class="bg-cardBg p-5 rounded-3xl border border-slate-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Tugas</p>
                            <h4 id="stat-total" class="text-3xl font-bold text-white mt-1">0</h4>
                            <span class="text-xs text-blue-400 mt-1 inline-block">Target Harian</span>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-primaryBlue/20 text-primaryBlue flex items-center justify-center text-2xl">
                            <i class="ph-fill ph-list-checks"></i>
                        </div>
                    </div>

                    <!-- Kartu Tugas Selesai -->
                    <div class="bg-cardBg p-5 rounded-3xl border border-slate-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Tugas Selesai</p>
                            <h4 id="stat-selesai" class="text-3xl font-bold text-accentGreen mt-1">0</h4>
                            <span class="text-xs text-emerald-400/80 mt-1 inline-block">Sudah Dikerjakan</span>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-accentGreen/20 text-accentGreen flex items-center justify-center text-2xl">
                            <i class="ph-fill ph-check-circle"></i>
                        </div>
                    </div>

                    <!-- Kartu Belum Selesai -->
                    <div class="bg-cardBg p-5 rounded-3xl border border-slate-800/80 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Belum Selesai</p>
                            <h4 id="stat-belum" class="text-3xl font-bold text-accentOrange mt-1">0</h4>
                            <span class="text-xs text-amber-400/80 mt-1 inline-block">Perlu Dikerjakan</span>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-accentOrange/20 text-accentOrange flex items-center justify-center text-2xl">
                            <i class="ph-fill ph-clock-countdown"></i>
                        </div>
                    </div>
                </div>

                <!-- Fitur (3): Daftar Checklist Tugas Piket -->
                <div class="bg-cardBg rounded-3xl p-6 border border-slate-800/80 shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
                        <div>
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i class="ph-fill ph-clipboard-text text-primaryBlue text-xl"></i>
                                Daftar Checklist Tugas Piket
                            </h3>
                            <p class="text-xs text-slate-400 mt-0.5">Klik pada kotak tugas untuk menandai selesai atau belum.</p>
                        </div>
                        
                        <!-- Progress Bar Persentase -->
                        <div class="flex items-center gap-3 bg-darkBg px-3.5 py-2 rounded-2xl border border-slate-800">
                            <span class="text-xs font-medium text-slate-300">Progres:</span>
                            <div class="w-24 bg-slate-700 h-2 rounded-full overflow-hidden">
                                <div id="progress-bar" class="bg-accentGreen h-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                            <span id="progress-text" class="text-xs font-bold text-accentGreen">0%</span>
                        </div>
                    </div>

                    <!-- Container List Tugas (Diisi oleh JavaScript) -->
                    <div id="checklist-container" class="flex flex-col gap-3">
                        <!-- Item checklist akan muncul di sini -->
                    </div>
                </div>

            </div>

            <!-- KOLOM KANAN (4 Kolom pada layar besar: Jadwal Senin-Jumat & Info Kelompok/Lokasi) -->
            <div class="lg:col-span-4 flex flex-col gap-6">
                
                <!-- Fitur (1): Pemilih Jadwal Hari Senin - Jumat (Gaya Kalender Referensi) -->
                <div class="bg-cardBg rounded-3xl p-6 border border-slate-800/80 shadow-md">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-white text-base">Jadwal Piket Mingguan</h3>
                        <span class="text-xs bg-primaryBlue/20 text-primaryBlue font-semibold px-3 py-1 rounded-full">Senin - Jumat</span>
                    </div>
                    
                    <!-- Tombol Pilihan Hari Senin - Jumat -->
                    <div id="day-selector" class="grid grid-cols-5 gap-2">
                        <!-- Tombol Senin, Selasa, Rabu, Kamis, Jumat dirender via JS -->
                    </div>
                </div>

                <!-- Fitur (2): Kartu Nama Kelompok, Anggota & Lokasi Piket -->
                <div class="bg-cardBg rounded-3xl overflow-hidden border border-slate-800/80 shadow-md">
                    <!-- Header Kartu Biru -->
                    <div class="bg-primaryBlue p-5 text-white flex items-center justify-between">
                        <div>
                            <p class="text-xs text-blue-200 uppercase font-semibold tracking-wider">Kelompok Bertugas</p>
                            <h3 id="info-kelompok" class="text-xl font-bold mt-0.5">Kelompok Al-Farabi</h3>
                        </div>
                        <div class="bg-white/20 p-2.5 rounded-2xl">
                            <i class="ph-fill ph-users-three text-2xl"></i>
                        </div>
                    </div>

                    <!-- Isi Kartu: Lokasi & Daftar Santri -->
                    <div class="p-6 flex flex-col gap-5">
                        <!-- Lokasi Piket -->
                        <div class="bg-darkBg p-4 rounded-2xl border border-slate-800 flex items-start gap-3.5">
                            <div class="bg-pink-500/20 text-accentPink p-2.5 rounded-xl mt-0.5">
                                <i class="ph-fill ph-map-pin text-xl"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400 font-medium">Lokasi Area Piket</p>
                                <h4 id="info-lokasi" class="text-base font-bold text-white mt-0.5">Masjid & Teras Utama</h4>
                                <p id="info-waktu" class="text-xs text-slate-400 mt-1">Waktu: 06.30 WIB & 15.30 WIB</p>
                            </div>
                        </div>

                        <!-- Daftar Anggota Santri -->
                        <div>
                            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-3 flex items-center justify-between">
                                <span>Anggota Santri</span>
                                <span id="info-jumlah-anggota" class="text-primaryBlue">4 Santri</span>
                            </p>
                            <ul id="info-anggota-list" class="flex flex-col gap-2.5">
                                <!-- Daftar anggota diisi lewat JavaScript -->
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- =====================================================================
         3. MODAL KONFIRMASI RESET & NOTIFIKASI TOAST (Pengganti alert/confirm)
         ===================================================================== -->
    <!-- Modal Konfirmasi Reset -->
    <div id="reset-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-cardBg border border-slate-700 rounded-3xl p-6 max-w-sm w-full shadow-2xl transform transition-all">
            <div class="w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 flex items-center justify-center text-2xl mb-4">
                <i class="ph-fill ph-warning-circle"></i>
            </div>
            <h3 class="text-lg font-bold text-white">Reset Checklist Hari Ini?</h3>
            <p class="text-sm text-slate-400 mt-1.5">
                Semua tanda centang pada hari <span id="modal-hari-nama" class="text-white font-semibold">Senin</span> akan dikembalikan menjadi belum selesai.
            </p>
            <div class="flex items-center gap-3 mt-6">
                <button id="btn-batal-reset" class="flex-1 py-2.5 px-4 rounded-2xl bg-darkBg hover:bg-slate-800 text-slate-300 font-medium text-sm transition cursor-pointer">
                    Batal
                </button>
                <button id="btn-konfirmasi-reset" class="flex-1 py-2.5 px-4 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white font-medium text-sm transition cursor-pointer">
                    Ya, Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Notifikasi Toast Kecil di Pojok Kanan Bawah -->
    <div id="toast" class="fixed bottom-5 right-5 bg-emerald-600 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 text-sm font-medium transform translate-y-20 opacity-0 transition-all duration-300 z-50 pointer-events-none">
        <i class="ph-fill ph-check-circle text-lg"></i>
        <span id="toast-message">Status berhasil diperbarui!</span>
    </div>

    <!-- =====================================================================
         4. KODE JAVASCRIPT (Logika Aplikasi & Data Contoh)
         ===================================================================== -->
    <script>
        /**
         * DATA CONTOH JADWAL PIKET SANTRI (SENIN - JUMAT)
         * Disimpan dalam bentuk Objek JavaScript agar mudah dibaca dan diubah.
         */
        const dataPiket = {
            Senin: {
                singkatan: "Sen",
                tanggal: "1",
                kelompok: "Kelompok Al-Khawarizmi",
