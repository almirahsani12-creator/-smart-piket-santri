                ]
            },
            Rabu: {
                singkatan: "Rab",
                tanggal: "3",
                kelompok: "Kelompok Al-Farabi",
                lokasi: "Asrama Putra Lantai 1 & Teras",
                waktu: "Pukul 06.00 & 16.00 WIB",
                anggota: [
                    { nama: "Ilham Maulana", peran: "Ketua Kelompok" },
                    { nama: "Joko Susilo", peran: "Anggota" },
                    { nama: "Kurniawan Adi", peran: "Anggota" },
                    { nama: "Lukman Hakim", peran: "Anggota" }
                ],
                tugas: [
                    { id: 301, teks: "Menyapu dan mengepel lorong asrama", selesai: true },
                    { id: 302, teks: "Memastikan jemuran handuk tertata rapi", selesai: true },
                    { id: 303, teks: "Membersihkan kaca jendela kamar asrama", selesai: true },
                    { id: 304, teks: "Mengosongkan tempat sampah di depan kamar", selesai: false }
                ]
            },
            Kamis: {
                singkatan: "Kam",
                tanggal: "4",
                kelompok: "Kelompok Ibnu Khaldun",
                lokasi: "Perpustakaan & Lab Komputer",
                waktu: "Pukul 14.30 WIB (Pulang Sekolah)",
                anggota: [
                    { nama: "Muhammad Rizki", peran: "Ketua Kelompok" },
                    { nama: "Naufal Azmi", peran: "Anggota" },
                    { nama: "Oki Setiawan", peran: "Anggota" },
                    { nama: "Putra Ramadhan", peran: "Anggota" }
                ],
                tugas: [
