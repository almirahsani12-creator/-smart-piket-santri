                anggota: [
                    { nama: "Qori Abdurrahman", peran: "Ketua Kelompok" },
                    { nama: "Rafi Ahmad", peran: "Anggota" },
                    { nama: "Syahid Hidayat", peran: "Anggota" },
                    { nama: "Tariq Ziyad", peran: "Anggota" }
                ],
                tugas: [
                    { id: 501, teks: "Menyapu daun kering di halaman dan taman", selesai: true },
                    { id: 502, teks: "Menyiram tanaman hias di depan asrama", selesai: false },
                    { id: 503, teks: "Membersihkan meja dan kursi area kantin", selesai: false },
                    { id: 504, teks: "Memilah sampah organik dan anorganik", selesai: false }
                ]
            }
        };

        // Variabel untuk menyimpan hari yang sedang dipilih pengguna (Default: Senin)
        let hariAktif = "Senin";

        // Daftar urutan hari
        const daftarHari = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"];

        /**
         * FUNGSI 1: Merender Tombol Pilihan Hari (di Sidebar & Kartu Jadwal Mingguan)
         */
        function renderPemilihHari() {
            const daySelector = document.getElementById("day-selector");
            const sidebarNav = document.getElementById("sidebar-nav");
            
            // Bersihkan isi sebelumnya
            daySelector.innerHTML = "";
            // Sisakan judul kecil di sidebar
            sidebarNav.innerHTML = `<p class="text-xs uppercase tracking-wider text-blue-200 font-semibold px-3 mb-1 md:hidden lg:block">Jadwal Hari</p>`;

            daftarHari.forEach((hari) => {
                const isSelected = hari === hariAktif;
                const info = dataPiket[hari];

                // 1. Tombol di Kartu Jadwal Mingguan (Kanan)
                const btnCard = document.createElement("button");
                btnCard.className = `flex flex-col items-center justify-center py-3 px-1 rounded-2xl font-semibold transition-all duration-200 cursor-pointer ${
                    isSelected 
                    ? "bg-primaryBlue text-white shadow-lg shadow-primaryBlue/30 scale-105" 
                    : "bg-darkBg text-slate-400 hover:bg-cardHover hover:text-white border border-slate-800"
                }`;
                btnCard.innerHTML = `
                    <span class="text-[11px] uppercase opacity-80">${info.singkatan}</span>
                    <span class="text-base font-bold mt-1">${info.tanggal}</span>
                `;
                btnCard.onclick = () => gantiHari(hari);
                daySelector.appendChild(btnCard);

                // 2. Tombol di Sidebar (Kiri)
                const btnSide = document.createElement("button");
                btnSide.className = `flex items-center gap-3 w-full px-3.5 py-3 rounded-2xl font-medium text-sm transition-all duration-200 cursor-pointer ${
                    isSelected 
                    ? "bg-white text-primaryBlue font-bold shadow-md" 
                    : "text-blue-100 hover:bg-white/10"
                }`;
                btnSide.innerHTML = `
                    <i class="ph-fill ph-calendar-check text-lg"></i>
                    <span class="md:hidden lg:inline">${hari}</span>
                `;
                btnSide.onclick = () => gantiHari(hari);
                sidebarNav.appendChild(btnSide);
            });
        }

        /**
         * FUNGSI 2: Mengganti Hari Aktif dan Memperbarui Seluruh Tampilan
         */
        function gantiHari(hariBaru) {
            hariAktif = hariBaru;
            updateTampilan();
        }

        /**
         * FUNGSI 3: Memperbarui Seluruh Data di Layar (Info Kelompok, Statistik, & Checklist)
         */
        function updateTampilan() {
            const data = dataPiket[hariAktif];

            // 1. Update Badge Hari di Banner
            document.getElementById("badge-hari-ini").innerHTML = `<i class="ph ph-calendar-blank"></i> Jadwal Hari ${hariAktif}`;

            // 2. Update Info Kelompok & Lokasi Piket (Fitur 2)
            document.getElementById("info-kelompok").textContent = data.kelompok;
            document.getElementById("info-lokasi").textContent = data.lokasi;
            document.getElementById("info-waktu").textContent = data.waktu;
            document.getElementById("info-jumlah-anggota").textContent = `${data.anggota.length} Santri`;

            // Render Daftar Anggota Santri
            const listAnggota = document.getElementById("info-anggota-list");
            listAnggota.innerHTML = "";
            data.anggota.forEach((santri) => {
                // Ambil inisial nama untuk avatar bulat
                const inisial = santri.nama.split(" ").map(n => n[0]).join("").substring(0, 2);
                const li = document.createElement("li");
                li.className = "flex items-center justify-between bg-darkBg/60 px-3.5 py-2.5 rounded-2xl border border-slate-800/60";
                li.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-primaryBlue/20 text-primaryBlue font-bold text-xs flex items-center justify-center">
                            ${inisial}
                        </div>
                        <span class="text-sm font-medium text-slate-200">${santri.nama}</span>
                    </div>
                    <span class="text-[11px] px-2.5 py-0.5 rounded-full ${
                        santri.peran === 'Ketua Kelompok' 
                        ? 'bg-amber-500/20 text-amber-400 font-semibold' 
                        : 'bg-slate-800 text-slate-400'
                    }">${santri.peran}</span>
                `;
                listAnggota.appendChild(li);
            });

            // 3. Render Checklist Tugas (Fitur 3)
            const checklistContainer = document.getElementById("checklist-container");
            checklistContainer.innerHTML = "";

            data.tugas.forEach((item, index) => {
                const taskCard = document.createElement("div");
                taskCard.className = `flex items-center justify-between p-4 rounded-2xl border transition-all duration-200 cursor-pointer select-none ${
                    item.selesai 
                    ? "bg-emerald-950/20 border-emerald-500/30 text-slate-400" 
                    : "bg-darkBg border-slate-800 hover:border-primaryBlue/50 hover:bg-cardHover text-slate-200"
                }`;
                
                // Saat kartu tugas diklik, ubah status selesai/belum
                taskCard.onclick = () => toggleTugas(index);

                taskCard.innerHTML = `
                    <div class="flex items-center gap-3.5">
                        <!-- Kotak Centang Kustom -->
                        <div class="w-6 h-6 rounded-lg flex items-center justify-center transition-colors ${
                            item.selesai 
                            ? "bg-accentGreen text-white" 
                            : "border-2 border-slate-600 bg-cardBg"
                        }">
                            ${item.selesai ? '<i class="ph-bold ph-check text-sm"></i>' : ''}
                        </div>
                        
                        <!-- Teks Tugas -->
                        <span class="text-sm sm:text-base font-medium ${item.selesai ? 'line-through text-slate-500' : ''}">
                            ${item.teks}
                        </span>
                    </div>

                    <!-- Badge Status Kanan -->
                    <span class="text-xs font-semibold px-3 py-1 rounded-full hidden sm:inline-block ${
                        item.selesai 
                        ? "bg-accentGreen/20 text-accentGreen" 
                        : "bg-amber-500/10 text-amber-400"
                    }">
                        ${item.selesai ? "Selesai" : "Belum"}
                    </span>
                `;
                checklistContainer.appendChild(taskCard);
            });

            // 4. Hitung & Update Statistik Jumlah Tugas (Fitur 4)
            updateStatistik(data.tugas);

            // 5. Render ulang tombol hari agar highlight aktif selalu sinkron
            renderPemilihHari();
        }

        /**
         * FUNGSI 4: Mengubah Status Tugas (Selesai <-> Belum Selesai)
         */
        function toggleTugas(indexTugas) {
            const tugas = dataPiket[hariAktif].tugas[indexTugas];
            tugas.selesai = !tugas.selesai; // Membalik nilai true/false
            
            updateTampilan();
            
            if (tugas.selesai) {
                tampilkanToast("Alhamdulillah, tugas ditandai selesai!");
            }
        }

        /**
         * FUNGSI 5: Menghitung Jumlah Tugas Selesai, Belum Selesai, & Persentase
         */
        function updateStatistik(daftarTugas) {
            const total = daftarTugas.length;
            const selesai = daftarTugas.filter(t => t.selesai === true).length;
            const belum = total - selesai;
            const persentase = total === 0 ? 0 : Math.round((selesai / total) * 100);

            // Masukkan angka ke elemen HTML
            document.getElementById("stat-total").textContent = total;
            document.getElementById("stat-selesai").textContent = selesai;
            document.getElementById("stat-belum").textContent = belum;

            // Update Progress Bar
            document.getElementById("progress-bar").style.width = `${persentase}%`;
            document.getElementById("progress-text").textContent = `${persentase}%`;
        }

        /**
         * FUNGSI 6: Mengatur Tombol & Modal Reset Checklist (Fitur 5)
         */
        const modalReset = document.getElementById("reset-modal");
        const btnReset = document.getElementById("btn-reset");
        const btnBatalReset = document.getElementById("btn-batal-reset");
        const btnKonfirmasiReset = document.getElementById("btn-konfirmasi-reset");

        // Buka modal saat tombol reset diklik
        btnReset.onclick = () => {
            document.getElementById("modal-hari-nama").textContent = hariAktif;
            modalReset.classList.remove("hidden");
            modalReset.classList.add("flex");
        };

        // Tutup modal saat batal
        btnBatalReset.onclick = () => {
            modalReset.classList.add("hidden");
            modalReset.classList.remove("flex");
        };

        // Eksekusi reset semua tugas pada hari aktif menjadi false
        btnKonfirmasiReset.onclick = () => {
            dataPiket[hariAktif].tugas.forEach(tugas => {
                tugas.selesai = false;
            });
            
            modalReset.classList.add("hidden");
            modalReset.classList.remove("flex");
            
            updateTampilan();
            tampilkanToast(`Checklist hari ${hariAktif} berhasil direset!`);
        };

        /**
         * FUNGSI 7: Menampilkan Notifikasi Toast Sementara
         */
        let toastTimeout;
        function tampilkanToast(pesan) {
            const toast = document.getElementById("toast");
            document.getElementById("toast-message").textContent = pesan;
            
            toast.classList.remove("translate-y-20", "opacity-0");
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add("translate-y-20", "opacity-0");
            }, 2500);
        }

        // Jalankan aplikasi pertama kali saat halaman selesai dimuat
        window.onload = () => {
            updateTampilan();
        };
    </script>
</body>
</html>
